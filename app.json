{
  "expo": {
    "name": "阿雪的衣柜",
    "slug": "axue-wardrobe",
    "icon": "./assets/app-icon.png",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fffaf7",
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "允许阿雪的衣柜访问相册，以添加衣物图片。",
          "cameraPermission": "允许阿雪的衣柜使用相机，以拍摄衣物图片。"
        }
      ],
      "expo-asset",
      "expo-font",
      [
        "expo-status-bar",
        {
          "style": "dark",
          "hidden": false
        }
      ]
    ],
    "android": {
      "package": "com.axue.wardrobe",
      "softwareKeyboardLayoutMode": "resize",
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "ios": {
      "bundleIdentifier": "com.axue.wardrobe"
    },
    "extra": {
      "expo-status-bar": {
        "style": "dark",
        "hidden": false
      },
      "eas": {
        "projectId": "6ec4075f-2c93-443d-8033-13e9768cebea"
      }
    }
  }
}
